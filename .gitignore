# secrets — never commit
*.env
*token*
*.key
*.pem
tokens.json
.at
# large data
*.parquet
analysis/hf_cache/
# raw trajectory JSONL is too large for git (155MB) and is regenerable from
# the manifest + runner; keep derived results, not raw rows.
runs/**/*.jsonl
experiments/results/**/*.jsonl
experiments/results/**/*.log
*.zst
__pycache__/
.DS_Store
# latex build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/main.pdf

# HF staging tree: raw traces are 283MB and live on HuggingFace
# (AgentsSci/AAMAS2027-Roles, PRIVATE) and in FROZEN/, not in git.
# Derived parquet/docs ARE tracked; raw/ is not.
hf_artifact/raw/
paper/supplement.aux
paper/supplement.log
paper/supplement.out
paper/supplement.blg

# supplementary-material build: per-build staging trees (the zip itself is tracked)
submission/stage_*/
submission/supplementary_material/
